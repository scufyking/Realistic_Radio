// Data files embedded into realistic-radio.dll (extracted to <plugins>\realistic-radio\ on first start)
101 RCDATA "@RR_DATA@/ets2.json"
102 RCDATA "@RR_DATA@/ats.json"
103 RCDATA "@RR_DATA@/audio/whitestatic.mp3"
104 RCDATA "@RR_DATA@/audio/radio_switch.mp3"
105 RCDATA "@RR_DATA@/custom-stations-ets2.example.json"

// Version shown in the file properties (Details tab). Keep in sync with REALISTIC_RADIO_VERSION in src/Common.h.
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x2
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ScufyKing"
      VALUE "FileDescription", "Realistic Radio - ETS2/ATS telemetry plugin"
      VALUE "FileVersion", "1.1.0"
      VALUE "InternalName", "realistic-radio"
      VALUE "LegalCopyright", "Copyright (c) 2026 ScufyKing, MPL-2.0"
      VALUE "OriginalFilename", "realistic-radio.dll"
      VALUE "ProductName", "Realistic Radio"
      VALUE "ProductVersion", "1.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
